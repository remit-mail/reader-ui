{
	"name": "@remit/workbench",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"msw:init": "msw init public --no-save",
		"storybook": "storybook dev -p 6007 --no-open",
		"storybook:host": "storybook dev -p 6007 --no-open --host 0.0.0.0",
		"build-storybook": "npm run generate:routes -w @remit/web-client && storybook build",
		"test": "npm run test:typecheck && npm run test:run",
		"test:typecheck": "tsgo --noEmit",
		"test:run": "TZ=Europe/Amsterdam node $NODE_TEST_FLAGS --import tsx --import @remit/test-dom/css --test 'src/**/*.test.ts'",
		"test:stories": "vitest run && npm run test:published",
		"test:published": "node --test-timeout=900000 --import tsx --test 'src/**/*.browser-test.ts'"
	},
	"dependencies": {
		"@aws-amplify/ui-react": "6.15.4",
		"@remit/ui": "*",
		"lucide-react": "0.468.0",
		"temporal-polyfill": "1.0.6"
	},
	"devDependencies": {
		"@remit/test-dom": "*",
		"@storybook/addon-vitest": "9.1.21",
		"@storybook/react-vite": "9.1.21",
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "4.7.0",
		"@vitest/browser-playwright": "4.1.12",
		"msw": "2.15.0",
		"msw-storybook-addon": "2.0.7",
		"playwright": "1.58.2",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"storybook": "9.1.21",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"vite": "7.3.7",
		"vitest": "4.1.12"
	}
}
