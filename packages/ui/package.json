{
	"name": "@remit/ui",
	"version": "0.0.223",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./mcp-pages": "./src/mcp-pages.ts",
		"./rich-text": "./src/rich-text.ts",
		"./spellcheck-worker": "./src/components/rich-text-spellcheck-worker-provider.ts",
		"./tokens.css": "./src/tokens.css"
	},
	"scripts": {
		"storybook": "storybook dev -p 6008 --no-open",
		"build-storybook": "storybook build",
		"test": "npm run test:typecheck && npm run test:run",
		"test:typecheck": "tsgo --noEmit",
		"test:run": "node $NODE_TEST_FLAGS --import tsx --import @remit/test-dom/css --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/**/*.test.tsx' --test-coverage-lines=90 --test 'src/**/*.test.ts'",
		"prepack": "node ../../npm-scripts/pack-dist.mjs prepack",
		"postpack": "node ../../npm-scripts/pack-dist.mjs postpack"
	},
	"dependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/hanken-grotesk": "5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fullcalendar/react": "7.0.2",
		"@lexical/code-core": "0.49.0",
		"@lexical/html": "0.49.0",
		"@lexical/link": "0.49.0",
		"@lexical/list": "0.49.0",
		"@lexical/markdown": "0.49.0",
		"@lexical/react": "0.49.0",
		"@lexical/rich-text": "0.49.0",
		"@lexical/selection": "0.49.0",
		"@lexical/table": "0.49.0",
		"@lexical/utils": "0.49.0",
		"@react-types/shared": "3.36.0",
		"@use-gesture/react": "10.3.1",
		"@use-gesture/vanilla": "10.3.1",
		"clsx": "2.1.1",
		"dompurify": "3.4.17",
		"franc-min": "6.2.0",
		"lexical": "0.49.0",
		"lucide-react": "0.468.0",
		"react-aria": "3.50.0",
		"react-resizable-panels": "2.1.9",
		"react-simple-pull-to-refresh": "1.3.4",
		"tailwind-merge": "2.6.1",
		"temporal-polyfill": "1.0.4",
		"tldts": "7.4.9"
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@remit/domain-enums": "*"
	},
	"devDependencies": {
		"@remit/test-dom": "*",
		"@storybook/react": "9.1.21",
		"@storybook/react-vite": "9.1.21",
		"@tailwindcss/vite": "4.3.3",
		"dictionary-en": "4.0.0",
		"dictionary-en-gb": "3.0.0",
		"dictionary-nl": "2.0.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"storybook": "9.1.21",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"vite": "7.3.7"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/remit-mail/reader-ui.git",
		"directory": "packages/ui"
	},
	"packManifest": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./mcp-pages": {
				"types": "./dist/mcp-pages.d.ts",
				"default": "./dist/mcp-pages.js"
			},
			"./rich-text": {
				"types": "./dist/rich-text.d.ts",
				"default": "./dist/rich-text.js"
			},
			"./spellcheck-worker": {
				"types": "./dist/components/rich-text-spellcheck-worker-provider.d.ts",
				"default": "./dist/components/rich-text-spellcheck-worker-provider.js"
			},
			"./tokens.css": "./dist/tokens.css"
		},
		"files": [
			"dist"
		]
	}
}
