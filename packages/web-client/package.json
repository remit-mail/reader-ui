{
	"name": "@remit/web-client",
	"version": "0.0.325",
	"type": "module",
	"description": "Remit web client, published as composable primitives — the app shell, auth shells, and runtime config. A distributor imports what it composes and bundles it.",
	"exports": {
		"./shell": "./src/shell/index.tsx",
		"./config": "./src/runtime-config.ts",
		"./auth/provider": "./src/auth/provider.tsx",
		"./auth/cognito": "./src/auth/cognito-provider.tsx",
		"./auth/better-auth": "./src/auth/better-auth-provider.tsx",
		"./auth/combined": "./src/auth/combined-provider.tsx",
		"./styles/app.css": "./src/index.css",
		"./styles/cognito.css": "./src/auth/cognito/cognito.css",
		"./vite-preset": "./harness/vite-preset.ts"
	},
	"scripts": {
		"dev": "vite",
		"generate:routes": "node scripts/generate-routes.mjs",
		"prepack": "npm run generate:routes && node ../../npm-scripts/pack-dist.mjs prepack",
		"build": "npm run generate:routes && tsc -b && vite build",
		"preview": "vite preview",
		"test:typecheck": "npm run generate:routes && tsgo --noEmit && tsgo --noEmit -p tsconfig.node.json",
		"test:run": "TSX_TSCONFIG_PATH=./tsconfig.test.json node $NODE_TEST_FLAGS --import tsx --import ./test-support/register.mjs --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/**/*.test.tsx' --test-coverage-exclude='src/test-support/**' --test-coverage-lines=86 --test 'src/**/*.test.ts' 'spellcheck/**/*.test.ts'",
		"test": "npm run test:typecheck && npm run test:run",
		"postpack": "node ../../npm-scripts/pack-dist.mjs postpack"
	},
	"peerDependencies": {
		"dictionary-en": "^4",
		"dictionary-en-gb": "^3",
		"dictionary-nl": "^2",
		"react": "^19",
		"react-dom": "^19",
		"vite": "^7",
		"@vitejs/plugin-react": "^4",
		"@tailwindcss/vite": "^4",
		"tailwindcss": "^4",
		"@tanstack/router-plugin": "^1",
		"@types/react-dom": "^19",
		"@remit/api-http-client": "*",
		"@remit/data-ports": "*",
		"@remit/domain-enums": "*",
		"@remit/mail-oauth-service": "*"
	},
	"peerDependenciesMeta": {
		"dictionary-en": {
			"optional": true
		},
		"dictionary-en-gb": {
			"optional": true
		},
		"dictionary-nl": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"@vitejs/plugin-react": {
			"optional": true
		},
		"@tailwindcss/vite": {
			"optional": true
		},
		"tailwindcss": {
			"optional": true
		},
		"@tanstack/router-plugin": {
			"optional": true
		}
	},
	"dependencies": {
		"@hookform/resolvers": "5.4.0",
		"@remit/ui": "*",
		"@tanstack/react-query": "5.101.2",
		"@tanstack/react-query-devtools": "5.101.2",
		"@tanstack/react-router": "1.170.18",
		"@tanstack/react-virtual": "3.14.6",
		"aws-amplify": "6.18.0",
		"@aws-amplify/ui-react": "6.15.4",
		"aws-rum-web": "3.1.0",
		"better-auth": "1.7.12",
		"i18next": "24.2.3",
		"i18next-browser-languagedetector": "8.2.1",
		"i18next-http-backend": "4.0.4",
		"lucide-react": "0.468.0",
		"p-map": "2.1.0",
		"react-hook-form": "7.82.0",
		"react-i18next": "15.7.4",
		"vaul": "1.1.2",
		"zod": "4.6.7",
		"@remit/spellcheck-engine": "0.0.1"
	},
	"devDependencies": {
		"@remit/test-dom": "*",
		"@storybook/react-vite": "9.1.21",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-generator": "1.167.21",
		"@tanstack/router-plugin": "1.168.22",
		"@types/jsdom": "28.0.3",
		"@vitejs/plugin-react": "4.7.0",
		"dictionary-en": "4.0.0",
		"dictionary-en-gb": "3.0.0",
		"dictionary-nl": "2.0.0",
		"esbuild": "0.28.1",
		"jsdom": "29.1.1",
		"msw": "2.15.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"vite": "7.3.7"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/remit-mail/reader-ui.git",
		"directory": "packages/web-client"
	},
	"packManifest": {
		"exports": {
			"./shell": {
				"types": "./dist/src/shell/index.d.ts",
				"default": "./dist/src/shell/index.js"
			},
			"./config": {
				"types": "./dist/src/runtime-config.d.ts",
				"default": "./dist/src/runtime-config.js"
			},
			"./auth/provider": {
				"types": "./dist/src/auth/provider.d.ts",
				"default": "./dist/src/auth/provider.js"
			},
			"./auth/cognito": {
				"types": "./dist/src/auth/cognito-provider.d.ts",
				"default": "./dist/src/auth/cognito-provider.js"
			},
			"./auth/better-auth": {
				"types": "./dist/src/auth/better-auth-provider.d.ts",
				"default": "./dist/src/auth/better-auth-provider.js"
			},
			"./auth/combined": {
				"types": "./dist/src/auth/combined-provider.d.ts",
				"default": "./dist/src/auth/combined-provider.js"
			},
			"./styles/app.css": "./dist/src/index.css",
			"./styles/cognito.css": "./dist/src/auth/cognito/cognito.css",
			"./vite-preset": {
				"types": "./dist/harness/vite-preset.d.ts",
				"default": "./dist/harness/vite-preset.js"
			}
		},
		"files": [
			"dist",
			"public"
		]
	}
}
