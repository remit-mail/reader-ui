{
	"name": "reader-ui",
	"version": "0.0.0",
	"private": true,
	"description": "The Remit reader user interface: components, the web client and the Storybook that renders them.",
	"type": "module",
	"license": "MIT",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"fix": "biome check --write",
		"check": "biome ci",
		"typecheck": "npm run test:typecheck --workspaces --if-present",
		"test": "npm run test:run -w @remit/ui -w @remit/workbench && npm run test:web-client",
		"test:web-client": "node npm-scripts/test-web-client.mjs",
		"test:scripts": "node npm-scripts/test-script-suites.mjs",
		"test:stories": "bash npm-scripts/stories-install.sh && npm run test:stories -w @remit/workbench",
		"storybook": "npm run storybook:host -w @remit/workbench",
		"build-storybook": "npm run build-storybook -w @remit/workbench",
		"icons:generate": "bash npm-scripts/generate-icons.sh",
		"check:web-client-consumer": "node npm-scripts/check-web-client-consumer.mjs",
		"release": "node npm-scripts/publish-packages.mjs",
		"release:dry-run": "node npm-scripts/publish-packages.mjs --dry-run",
		"ci": "npm run check && npm run test:scripts && npm run typecheck && npm run test && npm run test:stories && npm run release:dry-run && npm run check:web-client-consumer"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@remit/api-http-client": "0.0.78",
		"@remit/data-ports": "0.0.89",
		"@remit/domain-enums": "0.0.29",
		"@remit/mail-oauth-service": "0.0.9",
		"@remit/spellcheck-engine": "0.0.1",
		"@tanstack/react-query": "5.101.2",
		"@types/node": "26.1.1",
		"@typescript/native-preview": "7.0.0-dev.20260505.1",
		"tsx": "4.23.1",
		"typescript": "5.9.3"
	},
	"overrides": {
		"@modelcontextprotocol/sdk": {
			"zod": "^4.6.7"
		},
		"@vitest/mocker": "^4.1.12",
		"@xmldom/xmldom": "^0.8.15",
		"adm-zip": "^0.6.0",
		"ajv": "^8.18.0",
		"brace-expansion@^2": "^2.1.7",
		"brace-expansion@^5": "^5.0.12",
		"browserslist": "^4.28.8",
		"deepmerge-ts": "^8.0.1",
		"esbuild": "^0.28.1",
		"fast-uri": "^3.1.8",
		"ip-address": "^10.7.1",
		"js-yaml": "^4.3.2",
		"nanoid@^3": "^3.3.18",
		"postcss": "^8.5.26",
		"proxy-addr": "^2.0.8",
		"qs": "^6.16.0",
		"seroval": "^1.6.3",
		"sharp": "^0.35.5",
		"source-map-js": "^1.2.2",
		"tar": "^7.5.21",
		"toml": "^4.2.0",
		"undici": "^7.29.1",
		"uuid": "^13.0.2"
	}
}
